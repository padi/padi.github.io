---
import Base from '../layouts/Base.astro';
---

<Base title="Selected work" description="Web apps Marc has made or maintained over 10+ years, as part of teams and as a freelancer.">
  <section class="wrap work-head">
    <h1 class="display d1">Selected work</h1>
    <p class="lede">Web apps I've made or maintained over 10+ years, as part of teams and as a freelancer.</p>
  </section>

  <section class="wrap named" aria-label="Named work">
    <div>
      <h2 class="display d2"><a href="http://aelogica.com">aelogica</a></h2>
      <p><span class="ph">[What you built or looked after there, in a sentence or two]</span></p>
    </div>
    <div>
      <h2 class="display d2"><a href="https://trafficdito.com">TrafficDito.com</a></h2>
      <p><span class="ph">[What you built or looked after there, in a sentence or two]</span></p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="freelance-title">
    <h2 class="display d2" id="freelance-title">As a freelancer</h2>
    <ul class="fields">
      <li><span class="display d3">eCommerce</span><span>Custom platform and Shopify apps. <span class="ph">[One result]</span></span></li>
      <li><span class="display d3">Health and fitness</span><span class="ph">[What the app did and what you did]</span></li>
      <li><span class="display d3">Real estate, self-storage, senior living</span><span class="ph">[What the app did and what you did]</span></li>
      <li><span class="display d3">Digital marketing</span><span>Manychat and Facebook chatbot funnels. <span class="ph">[One result]</span></span></li>
      <li><span class="display d3">Golf</span><span class="ph">[What the app did and what you did]</span></li>
      <li><span class="display d3">An Australian book and TV show</span><span class="ph">[What the app did and what you did]</span></li>
    </ul>
  </section>
</Base>
