---
import { topics } from '../data/topics';
import { noteHref, noteMeta, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
  showTopic?: boolean;
}

const { notes, showTopic = true } = Astro.props;
---

<ul class="notes" data-note-list>
  {
    notes.map((note) => (
      <li>
        <a class="row" href={noteHref(note)}>
          <span class:list={['shape', topics[note.data.topic].shape]} aria-hidden="true" />
          <span class="row-title">{note.data.title}</span>
          <span class="row-meta">{noteMeta(note, { showTopic })}</span>
        </a>
      </li>
    ))
  }
</ul>
